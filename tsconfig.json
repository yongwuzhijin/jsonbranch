{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "useDefineForClassFields": true,
    "types": ["node"]
  },
  "include": ["src", "packages", "apps", "vitest.config.ts", "scripts"],
  "exclude": ["**/*.e2e.ts", "**/dist/**", "**/node_modules/**"]
}
