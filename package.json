{
  "name": "jsonbranch",
  "private": true,
  "version": "0.1.0",
  "description": "枝序 JSONBranch：手动粘贴的 JSON 树，Chrome 扩展和 macOS 应用共用一份核心。",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:extension": "vite build --config apps/extension/vite.config.ts",
    "test:extension": "playwright test --config apps/extension/playwright.config.ts",
    "build:macos": "vite build --config apps/macos/vite.config.ts",
    "package:mac": "pnpm run build:macos && electron-builder --mac --config electron-builder.yml"
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "@tanstack/react-virtual": "3.14.13",
    "lucide-react": "0.577.0",
    "monaco-editor": "0.55.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["electron", "esbuild", "electron-winstaller"]
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.20.5",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.0",
    "electron": "43.7.5",
    "electron-builder": "26.15.3",
    "jsdom": "27.0.0",
    "typescript": "5.9.3",
    "vite": "7.2.2",
    "vitest": "5.0.3"
  }
}
